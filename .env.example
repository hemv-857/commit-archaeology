# ---- Commit Archaeology: server configuration ----
# Copy to .env and fill in what you need. Everything is optional in dev;
# the app falls back to in-memory queue + file cache when REDIS_URL /
# DATABASE_URL are unset.

# --- GitHub ---
# Comma-separated token pool. Strongly recommended in production: anonymous
# GitHub calls are limited to 60/hour per IP.
GITHUB_TOKENS=

# --- Storage (production) ---
# Postgres for cached analyses. Unset → JSON files under DATA_DIR.
DATABASE_URL=
# Redis for the BullMQ queue, rate limits and cross-process progress pub/sub.
# Unset → in-process queue + in-memory rate limiting.
REDIS_URL=

# --- App ---
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
# Set to 1 when running dedicated worker containers (docker compose --profile scale)
DISABLE_INLINE_WORKER=0
DATA_DIR=.data
# Cached stories older than this are re-scanned in the background (SWR).
REVALIDATE_AFTER_SEC=3600

# --- Analysis limits ---
MAX_PR_PAGES=20
MAX_COMMIT_COUNT=200000
SCAN_CONCURRENCY=2
CLONE_TIMEOUT_MS=300000
# Reject repos larger than this (GitHub `size`, KB; 1024 ≈ 1 GB). Cloning a
# multi-GB repo occupies a worker slot until the timeout and usually fails in
# `git log` anyway. 512000 ≈ 500 MB.
MAX_REPO_SIZE_KB=512000
# git clone filter: blob:none (default, small clones) or none (full history)
CLONE_FILTER=blob:none

# --- Rate limiting (per IP) ---
RATE_LIMIT_SCAN_POINTS=5
RATE_LIMIT_SCAN_WINDOW_SEC=60
# How many scans one IP may have running at once. The rate limit above caps how
# often a client may ask; this stops a single client holding every worker slot.
# In-process only — across multiple web instances the rate limit is the guard.
MAX_CONCURRENT_SCANS_PER_IP=1
RATE_LIMIT_API_POINTS=60
RATE_LIMIT_API_WINDOW_SEC=60

# --- Optional AI era narration (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional Sentry ---
SENTRY_DSN=

# --- Logging ---
LOG_LEVEL=info
