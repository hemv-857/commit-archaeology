{
  "name": "commit-archaeology",
  "version": "1.0.0",
  "private": true,
  "description": "Turn any public GitHub repository's commit history into a readable narrative story.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixture:repos": "tsx tests/fixtures/make-fixture-repos.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.0.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.6.0",
    "next": "^15.3.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.0",
    "pino-pretty": "^13.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
